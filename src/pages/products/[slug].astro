---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import { kitchenProducts, type Product } from '../../data/products';

export async function getStaticPaths() {
  return kitchenProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.name,
  "image": product.images.map(img => `https://kitchenfinds.com${img}`),
  "description": product.summary,
  "offers": {
    "@type": "Offer",
    "priceCurrency": "USD",
    "price": product.price.replace('$', ''),
    "availability": "https://schema.org/InStock",
    "url": product.affiliateUrl
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": product.score,
    "reviewCount": product.reviewCount.replace(',', '')
  }
};
---

<BaseLayout 
  title={`${product.name} - Best Finds`}
  description={product.summary}
  jsonLd={productSchema}
>
  <div class="bg-slate-100 py-8 border-b border-slate-200 text-xs sm:text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-slate-500">
        <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
        <span>&rsaquo;</span>
        <a href="/#kitchen-finds" class="hover:text-slate-900 transition-colors">Kitchen Finds</a>
        <span>&rsaquo;</span>
        <span class="text-slate-900 font-semibold truncate max-w-xs sm:max-w-md">{product.name}</span>
      </nav>
    </div>
  </div>

  <main class="py-10 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-10 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
          
          <!-- Product Media Gallery (Left) -->
          <div class="lg:col-span-6 space-y-4">
            <div class="relative overflow-hidden rounded-xl border border-slate-200 bg-white group p-4">
              <img 
                id="main-display-image"
                src={product.images[0]} 
                alt={product.name} 
                class="w-full h-80 sm:h-[450px] object-contain transition-all duration-300"
              />
              <span class="absolute top-4 left-4 bg-emerald-600 text-white text-xs font-bold px-3 py-1 rounded-md shadow-sm">
                {product.badgeText}
              </span>
            </div>

            <!-- Thumbnail Slider -->
            <div class="grid grid-cols-4 gap-3">
              {product.images.map((imgUrl, index) => (
                <button 
                  type="button" 
                  onclick={`document.getElementById('main-display-image').src='${imgUrl}'`}
                  class="border-2 border-slate-200 hover:border-emerald-500 focus:border-emerald-600 rounded-lg p-1 bg-white transition-all overflow-hidden"
                >
                  <img src={imgUrl} alt={`Thumbnail ${index + 1}`} class="w-full h-20 object-contain rounded" />
                </button>
              ))}
            </div>
          </div>

          <!-- Product Details & Purchase Action (Right) -->
          <div class="lg:col-span-6 flex flex-col justify-between space-y-6">
            
            <div class="space-y-5">
              
              <!-- Badges & Rating -->
              <div class="flex items-center justify-between flex-wrap gap-2">
                <span class="text-xs font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full border border-emerald-300">
                  {product.rank}
                </span>
                <div class="flex items-center gap-1.5 text-sm">
                  <span class="text-amber-500 font-bold text-base">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                  <span class="font-bold text-slate-900">{product.score}</span>
                  <span class="text-slate-500 text-xs">({product.reviewCount} customer reviews)</span>
                </div>
              </div>

              <!-- Product Title -->
              <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-snug">
                {product.name}
              </h1>

              <div class="bg-slate-50 p-3 rounded-lg border border-slate-200">
                <span class="text-xs font-mono text-slate-600 block">{product.fullName}</span>
              </div>

              <!-- Pricing Callout -->
              <div class="flex items-baseline gap-3 py-2 border-y border-slate-100">
                <span class="text-3xl font-extrabold text-slate-900">{product.price}</span>
                {product.originalPrice && (
                  <span class="text-base text-slate-400 line-through">{product.originalPrice}</span>
                )}
                <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded border border-emerald-200">
                  Best Value Deal
                </span>
              </div>

              <!-- Quick Description -->
              <p class="text-slate-600 text-sm leading-relaxed">
                {product.summary}
              </p>

              <!-- Key Features Bullets -->
              <div class="space-y-2 pt-2">
                <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Product Highlights</h3>
                <ul class="space-y-2 text-xs sm:text-sm text-slate-700">
                  {product.highlights.map(item => (
                    <li class="flex items-start gap-2.5">
                      <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

            </div>

            <!-- Outbound Affiliate CTA -->
            <div class="pt-6 border-t border-slate-200 space-y-3">
              <div class="flex items-center justify-between text-xs">
                <span class="text-slate-500 font-medium">Availability</span>
                <span class="text-emerald-600 font-bold flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  In Stock — Dispatches Immediately
                </span>
              </div>

              <AffiliateButton 
                href={product.affiliateUrl} 
                text="Check Price & Order Now" 
                subtext="View current deals & options"
                variant="primary"
                class="w-full py-4 text-base bg-emerald-600 hover:bg-emerald-700 border-emerald-700 shadow-md"
              />
            </div>

          </div>

        </div>

        <!-- Detailed Specifications & In-Depth Overview -->
        <div class="mt-12 pt-10 border-t border-slate-200 grid grid-cols-1 lg:grid-cols-12 gap-10">
          
          <div class="lg:col-span-7 space-y-6">
            <h2 class="text-xl font-bold text-slate-900 tracking-tight">Full Product Overview</h2>
            <div class="space-y-4 text-slate-700 text-sm leading-relaxed">
              {product.descriptionParagraphs.map(paragraph => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>

          <div class="lg:col-span-5 space-y-4">
            <h2 class="text-xl font-bold text-slate-900 tracking-tight">Technical Specifications</h2>
            <div class="bg-slate-50 rounded-xl border border-slate-200 divide-y divide-slate-200 text-xs sm:text-sm">
              {product.specs.map(spec => (
                <div class="p-3.5 flex justify-between gap-4">
                  <span class="font-medium text-slate-500">{spec.label}</span>
                  <span class="font-bold text-slate-900 text-right">{spec.value}</span>
                </div>
              ))}
            </div>
          </div>

        </div>

      </div>

    </div>
  </main>
</BaseLayout>
