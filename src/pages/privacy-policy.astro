---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Privacy Policy & Store Terms"
  description="Privacy Policy and terms of use for Best Kitchen Finds product directory."
>
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div>
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Privacy Policy</h1>
        <p class="text-slate-500 text-sm mt-1">Last Updated: September 2026</p>
      </div>

      <div class="space-y-6 text-slate-700 text-sm sm:text-base leading-relaxed">
        
        <div class="space-y-2">
          <h2 class="text-xl font-bold text-slate-900">1. Product Store Notice</h2>
          <p>
            Best Kitchen Finds is a product discovery website. We provide links to external merchant stores and sellers. When you click on product links on our site, you will be redirected to third-party online stores to complete your transaction.
          </p>
        </div>

        <div class="space-y-2 border-t border-slate-200 pt-6">
          <h2 class="text-xl font-bold text-slate-900">2. Cookies and Tracking</h2>
          <p>
            Our site may use standard technical cookies to analyze site traffic and enhance user navigation. Third-party vendor platforms may place cookies to confirm outbound visits when purchasing items.
          </p>
        </div>

        <div class="space-y-2 border-t border-slate-200 pt-6">
          <h2 class="text-xl font-bold text-slate-900">3. Contact & Support</h2>
          <p>
            If you have questions regarding our curated list or site policies, please contact us through our official site channels.
          </p>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>
