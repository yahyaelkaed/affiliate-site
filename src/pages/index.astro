---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import { kitchenProducts } from '../data/products';

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Best Finds",
  "url": "https://kitchenfinds.com",
  "description": "Curated directory of the best kitchen finds, air fryer accessories, and clever home gadgets.",
  "publisher": {
    "@type": "Organization",
    "name": "Best Finds"
  }
};
---

<BaseLayout 
  title="Best Finds - Top Curated Kitchen Gadgets & Accessories"
  description="Discover the best kitchen finds, cooking accessories, and daily household tools with full reviews and deal links."
  jsonLd={websiteSchema}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900 text-white border-b border-slate-800 py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        
        <span class="inline-flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/></svg>
          Best Finds Collection
        </span>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Best Finds for Modern Homes & Kitchens
        </h1>

        <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
          Handpicked product recommendations tested for convenience, style, and everyday utility.
        </p>

        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a 
            href="#kitchen-finds" 
            class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm px-5 py-3 rounded-lg shadow-md transition-all no-underline inline-flex items-center gap-2"
          >
            Browse Kitchen Finds &rarr;
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Amazon-Style Kitchen Finds Section -->
  <section id="kitchen-finds" class="py-12 bg-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <!-- Section Title Header -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-slate-300 pb-4 gap-2">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
            <span>Kitchen Finds</span>
            <span class="bg-emerald-100 text-emerald-800 text-xs px-2.5 py-0.5 rounded-full font-bold">Trending</span>
          </h2>
          <p class="text-slate-600 text-sm mt-1">Explore our top recommended kitchen accessories and oil sprayers product by product.</p>
        </div>
      </div>

      <!-- Amazon-Style Product Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {kitchenProducts.map((product) => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
            
            <!-- Card Upper Container -->
            <div>
              <!-- Product Image Thumbnail -->
              <a href={`/products/${product.slug}`} class="block relative overflow-hidden bg-white p-6 border-b border-slate-100">
                <img 
                  src={product.images[0]} 
                  alt={product.name} 
                  class="w-full h-64 object-contain group-hover:scale-105 transition-transform duration-300"
                />
                <span class="absolute top-3 left-3 bg-emerald-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-md shadow-sm">
                  {product.badgeText}
                </span>
              </a>

              <!-- Card Body Content -->
              <div class="p-6 space-y-3">
                <!-- Category & Rating -->
                <div class="flex items-center justify-between text-xs text-slate-500">
                  <span class="font-bold text-emerald-700 uppercase tracking-wider bg-emerald-50 px-2.5 py-0.5 rounded border border-emerald-200">
                    {product.category}
                  </span>
                  <div class="flex items-center gap-1 font-semibold text-slate-700">
                    <span class="text-amber-500 font-bold">&#9733;</span>
                    <span>{product.score}</span>
                    <span class="text-slate-400">({product.reviewCount})</span>
                  </div>
                </div>

                <!-- Product Title Link -->
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-emerald-600 transition-colors line-clamp-2 leading-snug">
                  <a href={`/products/${product.slug}`} class="no-underline text-inherit">
                    {product.name}
                  </a>
                </h3>

                <!-- Price Block -->
                <div class="flex items-baseline gap-2 pt-1">
                  <span class="text-2xl font-extrabold text-slate-900">{product.price}</span>
                  {product.originalPrice && (
                    <span class="text-xs text-slate-400 line-through">{product.originalPrice}</span>
                  )}
                </div>

                <!-- Short Teaser -->
                <p class="text-slate-600 text-xs leading-relaxed line-clamp-3 pt-1">
                  {product.summary}
                </p>
              </div>
            </div>

            <!-- Card Action Footer -->
            <div class="p-6 pt-0 space-y-2">
              <a 
                href={`/products/${product.slug}`}
                class="w-full inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold py-3 px-4 rounded-lg shadow-sm transition-colors no-underline"
              >
                <span>View Full Details & Specs</span>
                <span>&rarr;</span>
              </a>

              <AffiliateButton 
                href={product.affiliateUrl} 
                text="Check Price & Deals" 
                subtext="Direct seller store link"
                variant="primary"
                class="w-full text-xs py-2.5 bg-emerald-600 hover:bg-emerald-700 border-emerald-700"
              />
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>
