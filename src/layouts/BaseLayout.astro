---
interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  image?: string;
}

const {
  title,
  description = "Independent reviews and buying guides for portable power stations and solar generators.",
  jsonLd,
  image = "/images/og-default.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://powerstationhub.com");
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title} | Best Kitchen Finds</title>
    <meta name="title" content={`${title} | Best Kitchen Finds`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Schema.org JSON-LD injection -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <slot name="head" />
  </head>
  <body class="bg-slate-100 text-slate-900 font-sans min-h-screen flex flex-col antialiased selection:bg-amber-600 selection:text-white" style="font-family: 'Inter', sans-serif;">
    
    <!-- Navigation Header -->
    <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 sm:h-20">
          
          <!-- Brand Logo -->
          <a href="/" class="flex items-center gap-2.5 no-underline group">
            <div class="w-9 h-9 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-bold shadow-sm">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.46 3.9 3.43 4.38l-.43 7.62h2l-.43-7.62C9.54 12.9 11 11.12 11 9zm7-7h-2v20h2v-8h3V2h-3zm0 4h1.5v4H18V6z"/>
              </svg>
            </div>
            <div>
              <span class="text-xl font-bold tracking-tight text-white group-hover:text-emerald-400 transition-colors">Best<span class="text-emerald-500">Finds</span></span>
              <span class="block text-[10px] uppercase font-medium tracking-widest text-slate-400">Curated Home & Kitchen Gadgets</span>
            </div>
          </a>

          <!-- Main Navigation -->
          <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-300">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <a href="/#kitchen-finds" class="text-emerald-400 hover:text-emerald-300 font-semibold">Kitchen Finds</a>
            <a href="/privacy-policy" class="hover:text-white transition-colors">Store Info</a>
          </nav>

          <!-- Quick Action Link -->
          <div class="hidden sm:flex items-center gap-4">
            <a 
              href="#featured-finds" 
              class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2 rounded-md shadow-sm transition-colors no-underline"
            >
              Explore Products &rarr;
            </a>
          </div>

        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-300 pt-12 pb-10 border-t border-slate-800 text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-b border-slate-800">
          
          <!-- Column 1: Brand -->
          <div class="space-y-3">
            <a href="/" class="flex items-center gap-2 no-underline">
              <div class="w-7 h-7 rounded bg-emerald-600 flex items-center justify-center text-white font-bold">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.46 3.9 3.43 4.38l-.43 7.62h2l-.43-7.62C9.54 12.9 11 11.12 11 9zm7-7h-2v20h2v-8h3V2h-3zm0 4h1.5v4H18V6z"/>
                </svg>
              </div>
              <span class="text-base font-bold text-white">Kitchen<span class="text-emerald-500">Finds</span></span>
            </a>
            <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
              Discover top-rated kitchen gadgets, oil sprayers, cooking accessories, and essential meal-prep tools for modern home cooks.
            </p>
          </div>

          <!-- Column 2: Navigation Links -->
          <div class="space-y-2">
            <h4 class="text-xs font-bold text-white uppercase tracking-wider">Quick Links</h4>
            <ul class="space-y-1.5 text-xs text-slate-300">
              <li><a href="/" class="hover:text-white transition-colors">Homepage</a></li>
              <li><a href="#featured-finds" class="hover:text-white transition-colors text-emerald-400 font-semibold">Featured Kitchen Finds</a></li>
              <li><a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a></li>
            </ul>
          </div>

          <!-- Column 3: Notice -->
          <div class="space-y-2">
            <h4 class="text-xs font-bold text-white uppercase tracking-wider">Product Directory Notice</h4>
            <p class="text-xs text-slate-400 leading-relaxed">
              We curate top-rated kitchen supplies and cooking tools. Clicking purchase links will redirect you to official seller stores to complete your order securely.
            </p>
          </div>

        </div>

        <!-- Disclosure Statement -->
        <div class="bg-slate-950 p-4 rounded-lg border border-slate-800 text-xs text-slate-400 space-y-1">
          <p class="font-semibold text-slate-300">Shopping Disclosure:</p>
          <p class="leading-relaxed">
            Best Kitchen Finds is a curated directory of trending kitchenware and cooking accessories. Product pricing, details, and availability are subject to seller terms at checkout.
          </p>
        </div>

        <!-- Bottom Footer -->
        <div class="flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4 pt-2">
          <p>&copy; {new Date().getFullYear()} Best Kitchen Finds. All rights reserved.</p>
          <div class="flex items-center gap-6">
            <a href="/privacy-policy" class="hover:text-white underline">Privacy Policy</a>
            <a href="#" class="hover:text-white">Terms of Service</a>
          </div>
        </div>

      </div>
    </footer>

  </body>
</html>
