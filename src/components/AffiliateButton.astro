---
interface Props {
  href?: string;
  text?: string;
  subtext?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const {
  href = "https://www.amazon.com/dp/B0C8V2Y3B2?tag=powerstation-20",
  text = "Check Price on Amazon",
  subtext = "View current price & deals",
  variant = 'primary',
  class: className = ""
} = Astro.props;

const variantClasses = {
  primary: "bg-orange-600 hover:bg-orange-700 text-white font-bold shadow-sm hover:shadow border border-orange-700",
  secondary: "bg-slate-100 hover:bg-slate-200 text-slate-900 font-bold border border-slate-300"
}[variant];
---

<a
  href={href}
  target="_blank"
  rel="nofollow sponsored"
  class={`inline-flex flex-col items-center justify-center px-6 py-3 rounded-lg text-center transition-colors no-underline group cursor-pointer ${variantClasses} ${className}`}
>
  <span class="inline-flex items-center gap-2 text-sm sm:text-base tracking-tight">
    <!-- Amazon / Cart SVG Icon -->
    <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
      <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
    </svg>

    <span>{text}</span>

    <!-- Arrow SVG Icon -->
    <svg class="w-4 h-4 shrink-0 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
    </svg>
  </span>

  {subtext && (
    <span class="text-[11px] font-normal opacity-90 mt-0.5">
      {subtext}
    </span>
  )}
</a>
